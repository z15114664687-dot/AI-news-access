{
  "name": "ai-ecosystem-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "collect": "node scripts/collect.mjs",
    "links:repair": "node scripts/repair-source-links.mjs",
    "static:export": "node scripts/export-static-dashboard.mjs",
    "local:setup": "npm run db:setup",
    "local:open": "npm run local:setup && (sleep 2 && open http://127.0.0.1:3000) & next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "better-sqlite3": "12.4.6",
    "next": "16.2.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "9.17.0",
    "eslint-config-next": "16.2.4",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
